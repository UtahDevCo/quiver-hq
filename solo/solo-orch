#!/usr/bin/env bash
#
# solo-orch — project-agnostic Soloterm orchestration (committed in quiver-hq/solo).
#
# The SAME command works in EVERY registered Solo project: it auto-detects the
# project from your current directory ($PWD) by matching Solo's project paths.
# Shared child assets live next to this script (SOLO_HOME). Put it on PATH via
# quiver-hq/solo/install.sh (symlinks it into ~/.local/bin).
# All CLI shapes verified against solo-cli 0.8.2.
#
# First-time setup on a machine:  quiver-hq/solo/install.sh
# Register a new project once:     solo projects create <name> "<path>"
#
# Commands:
#   solo-orch project              show which Solo project $PWD maps to
#   solo-orch agents               list agent tools you can spawn (Claude, Codex, …)
#   solo-orch spawn <lane> "<obj>" create a lane todo + spawn ONE agent for it
#   solo-orch term  [name]         open a named terminal in this project
#   solo-orch note  "<text>"       append a note to this project's orchestration scratchpad
#   solo-orch status               agents + todos for THIS project
#   solo-orch gather               print each agent's recent output (this project)
#   solo-orch ps                   ALL processes across ALL projects (control plane)
#
# Cross-machine setup (quiver-hq is the transport):
#   solo-orch link [--dry-run]     symlink quiver-hq/local/* into each project
#   solo-orch provision [--dry-run] register every solo.yml project with Solo
#   solo-orch notes push|pull      scratchpads <-> quiver-hq/notes/<project>/
#
# Env overrides:  AGENT_TOOL=codex solo-orch spawn ...   (default: claude)
#
set -euo pipefail

# Resolve this script's real dir even when invoked through a symlink on PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  D="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"; [[ "$SOURCE" != /* ]] && SOURCE="$D/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
if [ -z "${SOLO_HOME:-}" ]; then
  if   [ -f "$SCRIPT_DIR/solo-child-lib.sh" ]; then SOLO_HOME="$SCRIPT_DIR"
  elif [ -d "$SCRIPT_DIR/../solo" ];          then SOLO_HOME="$(cd "$SCRIPT_DIR/../solo" && pwd)"
  else SOLO_HOME="$HOME/.solo"; fi
fi
CHILD_DOC="$SOLO_HOME/solo-child-agent.md"
CHILD_LIB="$SOLO_HOME/solo-child-lib.sh"
SCRATCH_NAME="orchestration"

die(){ echo "solo-orch: $*" >&2; exit 1; }
# Checked per-command, not up front: `link` only touches files, and it has to
# work on the Linux box, where Solo has no build yet.
need_solo(){
  command -v solo >/dev/null || die "'solo' not on PATH — run quiver-hq/solo/install.sh"
  command -v jq   >/dev/null || die "'jq' required"
}

# --- Project auto-detection: longest project path that is a prefix of $PWD ---
detect(){
  solo projects list --json | jq -r --arg p "$PWD" '
    .data.projects
    | map(. as $x | select($p==$x.path or ($p|startswith($x.path+"/"))))
    | sort_by(.path|length) | last
    | select(.!=null) | "\(.id)\t\(.name)\t\(.path)"'
}
need_pid(){ local d; d=$(detect); [ -n "$d" ] || die "no Solo project matches $PWD.
  Register it once with:  solo projects create <name> \"$PWD\""; echo "$d" | cut -f1; }

ensure_scratchpad(){ # pid -> id (get-or-create the 'orchestration' scratchpad)
  local id; id=$(solo scratchpads list --project-id "$1" --json \
    | jq -r --arg n "$SCRATCH_NAME" '.data.scratchpads[]|select(.name==$n)|.id' | head -1)
  if [ -z "$id" ] || [ "$id" = null ]; then
    id=$(solo scratchpads create --project-id "$1" --name "$SCRATCH_NAME" \
         --content $'# Orchestration\n\n## Findings\n' --tag orchestration --json \
         | jq -r '.data.scratchpad.id')
  fi
  echo "$id"
}
scratch_rev(){ solo scratchpads list --project-id "$1" --json \
  | jq -r --argjson id "$2" '.data.scratchpads[]|select(.id==$id)|.revision'; }
append_guarded(){ # pid sp text  (revision-guarded, retries on conflict)
  local p="$1" sp="$2" text="$3" rev a
  for a in 1 2 3 4 5; do
    rev=$(scratch_rev "$p" "$sp")
    if solo scratchpads append "$sp" --project-id "$p" --content "$text" \
         --expected-revision "$rev" --newline --json | jq -e '.ok==true' >/dev/null; then return 0; fi
    sleep 0.4
  done; return 1
}
agent_tool_id(){ solo agents list --json \
  | jq -r --arg t "${AGENT_TOOL:-claude}" '.data.agentTools[]|select(.toolType==$t and .enabled)|.id' | head -1; }

cmd_project(){ local d; d=$(detect); [ -n "$d" ] || die "no project matches $PWD"; \
  echo "$d" | awk -F'\t' '{print "id="$1"  name="$2"  path="$3}'; }

cmd_agents(){ solo agents list --json \
  | jq -r '.data.agentTools[]|"\(.id)\t\(.name)\t\(.toolType)\t"+(if .enabled then "enabled" else "disabled" end)' \
  | column -t -s $'\t'; }

cmd_spawn(){
  local lane="${1:-}" obj="${2:-}"
  [ -n "$lane" ] && [ -n "$obj" ] || die "usage: solo-orch spawn <lane> \"<objective>\""
  local p sp tool tid; p=$(need_pid); sp=$(ensure_scratchpad "$p"); tool=$(agent_tool_id)
  [ -n "$tool" ] && [ "$tool" != null ] || die "no enabled '${AGENT_TOOL:-claude}' agent tool (see: solo-orch agents)"
  tid=$(solo todos create --project-id "$p" --title "[lane:$lane] $obj" \
        --body "Follow $CHILD_DOC. Lane=$lane." --tag lane --tag "$lane" --json | jq -r '.data.todo.id')
  local prompt="You are the '$lane' worker for this Solo project (id $p).
Read and follow $CHILD_DOC EXACTLY.
First export your context so the helper lib works:
  export SOLO_PROJECT_ID=$p SOLO_SCRATCHPAD_ID=$sp SOLO_LANE=$lane SOLO_TODO_ID=$tid SOLO_CHILD_LIB=$CHILD_LIB
Objective: $obj
Do ONLY the '$lane' lane. Append findings via solo_append, then complete your todo."
  solo processes spawn --project-id "$p" --kind agent --agent-tool-id "$tool" \
    --name "$lane-worker" --arg "$prompt" --json \
    | jq -r '"spawned \(.data.process.name) [id=\(.data.process.id)] \(.data.process.status)"' \
    && echo "  (todo=$tid scratchpad=$sp tool=${AGENT_TOOL:-claude})"
}

cmd_term(){ local p; p=$(need_pid); solo processes spawn --project-id "$p" --kind terminal \
  --name "${1:-terminal}" --json | jq -r '"terminal \(.data.process.name) [id=\(.data.process.id)] \(.data.process.status)"'; }

cmd_note(){ local p sp; p=$(need_pid); sp=$(ensure_scratchpad "$p"); \
  append_guarded "$p" "$sp" "$*" && echo "noted → scratchpad $sp" || die "append failed"; }

cmd_status(){ local p; p=$(need_pid); echo "PROJECT: $(cmd_project)"; \
  echo "AGENTS:"; solo processes list --project-id "$p" --json \
    | jq -r '.data.processes[]|select(.kind=="agent")|"  \(.id)\t\(.name)\t\(.status)"'; \
  echo "TODOS:";  solo todos list --project-id "$p" --json \
    | jq -r '.data.todos[]|"  \(.id)\t\(.status)\t\(.title)"'; }

cmd_gather(){ local p; p=$(need_pid); \
  solo processes list --project-id "$p" --json \
    | jq -r '.data.processes[]|select(.kind=="agent")|"\(.id)\t\(.name)"' \
  | while IFS=$'\t' read -r id name; do echo "───── $name (id $id) ─────"; \
      solo processes output "$id" --project-id "$p" --lines 30 --json | jq -r '.data.text'; done; }

cmd_ps(){ solo processes list --json \
  | jq -r '.data.processes[]|"\(.projectName)\t\(.kind)\t\(.name)\t\(.status)"' \
  | sort | column -t -s $'\t'; }

# --- Cross-machine setup -----------------------------------------------------
# quiver-hq is the transport. It cannot track files inside projects/* (those are
# submodule gitlinks), so the personal Claude layer lives in quiver-hq/local/
# and is symlinked into each project, where the work repos already gitignore it.
QUIVER_ROOT="${QUIVER_ROOT:-$(cd "$SOLO_HOME/.." 2>/dev/null && pwd || echo "")}"

# link_one <src-abs> <dst-abs> <rel-target> — idempotent, never destroys work.
link_one(){
  local src="$1" dst="$2" rel="$3"
  if [ -L "$dst" ]; then
    [ "$(readlink "$dst")" = "$rel" ] && { echo "  ok       ${dst#$QUIVER_ROOT/}"; return 0; }
    [ "$DRY" = 1 ] || { rm -f "$dst"; ln -s "$rel" "$dst"; }
    echo "  relink   ${dst#$QUIVER_ROOT/}"; return 0
  fi
  if [ -e "$dst" ]; then
    # A real file. Only replace it when it is byte-identical to the canonical
    # copy; otherwise it holds divergent work and we leave it for the human.
    if cmp -s "$src" "$dst"; then
      [ "$DRY" = 1 ] || { rm -f "$dst"; ln -s "$rel" "$dst"; }
      echo "  adopt    ${dst#$QUIVER_ROOT/}"
    else
      echo "  CONFLICT ${dst#$QUIVER_ROOT/} differs from local/ — left alone" >&2
      CONFLICTS=$((CONFLICTS+1))
    fi
    return 0
  fi
  [ -d "$(dirname "$dst")" ] || { echo "  no dir   $(dirname "${dst#$QUIVER_ROOT/}")" >&2; return 0; }
  [ "$DRY" = 1 ] || ln -s "$rel" "$dst"
  echo "  link     ${dst#$QUIVER_ROOT/}"
}

cmd_link(){
  DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1
  CONFLICTS=0
  [ -n "$QUIVER_ROOT" ] && [ -d "$QUIVER_ROOT/local" ] \
    || die "no local/ under '$QUIVER_ROOT' (set QUIVER_ROOT to your quiver-hq checkout)"
  [ "$DRY" = 1 ] && echo "DRY RUN — nothing will be written"
  local pdir proj dest
  for pdir in "$QUIVER_ROOT"/local/*/; do
    [ -d "$pdir" ] || continue
    proj="$(basename "$pdir")"
    dest="$QUIVER_ROOT/projects/$proj"
    if [ ! -d "$dest" ]; then echo "skip $proj (no projects/$proj here)"; continue; fi
    echo "$proj:"
    # projects/<proj>/CLAUDE.local.md -> ../../local/<proj>/CLAUDE.local.md
    [ -f "$pdir/CLAUDE.local.md" ] && \
      link_one "$pdir/CLAUDE.local.md" "$dest/CLAUDE.local.md" "../../local/$proj/CLAUDE.local.md"
    # Repo-controlled Solo config, same story: the submodule can't carry it.
    [ -f "$pdir/solo.yml" ] && \
      link_one "$pdir/solo.yml" "$dest/solo.yml" "../../local/$proj/solo.yml"
    # projects/<proj>/.claude/agents/X -> ../../../../local/<proj>/agents/X
    local a b
    for a in "$pdir"agents/*.local.md; do
      [ -e "$a" ] || continue
      b="$(basename "$a")"
      link_one "$a" "$dest/.claude/agents/$b" "../../../../local/$proj/agents/$b"
    done
  done
  if [ "$CONFLICTS" -gt 0 ]; then
    echo >&2
    echo "$CONFLICTS file(s) differ from local/ and were left untouched." >&2
    echo "Diff them, fold anything worth keeping into local/, then re-run." >&2
    return 1
  fi
}

# --- Scratchpad <-> notes/ bridge --------------------------------------------
# Solo has no cross-machine sync; scratchpads live in a local SQLite db. So the
# durable copy is a plain Markdown file under quiver-hq/notes/<project>/, which
# git carries like anything else.
#
# File shape is "# <title>" followed by the body, matching what Solo's own
# save-to-file produces. Solo stores the title as metadata rather than in the
# content, so the H1 is added on push and stripped on pull.
#
# Only ever use this on prose. Solo puts the title at the top of the file, which
# on a file with YAML frontmatter would land above the ---, so agent definitions
# stay in local/ and are handled by `link`.
slugify(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
  | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//'; }

sp_content(){ solo scratchpads read "$2" --project-id "$1" --json --mode content \
  | jq -r '.data.scratchpad.content'; }

notes_push(){ # pid dir
  local p="$1" dir="$2" list id name file tmp n=0 c=0
  list="$(mktemp)"; tmp="$(mktemp)"
  solo scratchpads list --project-id "$p" --json \
    | jq -r '.data.scratchpads[]|"\(.id)\t\(.name)"' > "$list"
  [ -s "$list" ] || { echo "  (no scratchpads)"; rm -f "$list" "$tmp"; return 0; }
  [ "$DRY" = 1 ] || mkdir -p "$dir"
  while IFS=$'\t' read -r id name; do
    [ -n "$id" ] || continue
    file="$dir/$(slugify "$name").md"
    printf '# %s\n\n%s\n' "$name" "$(sp_content "$p" "$id")" > "$tmp"
    n=$((n+1))
    if [ -f "$file" ] && cmp -s "$tmp" "$file"; then echo "  same     $(basename "$file")"; continue; fi
    [ "$DRY" = 1 ] || cp "$tmp" "$file"
    echo "  write    $(basename "$file")  <- \"$name\""; c=$((c+1))
  done < "$list"
  echo "  $n scratchpad(s), $c changed"
  rm -f "$list" "$tmp"
}

notes_pull(){ # pid dir
  local p="$1" dir="$2" f name body id rev list tmp n=0 c=0
  [ -d "$dir" ] || { echo "  (no $dir)"; return 0; }
  list="$(mktemp)"; tmp="$(mktemp)"
  solo scratchpads list --project-id "$p" --json \
    | jq -r '.data.scratchpads[]|"\(.name)\t\(.id)\t\(.revision)"' > "$list"
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    n=$((n+1))
    name="$(sed -n '1s/^#[[:space:]]*//p' "$f")"
    [ -n "$name" ] || { echo "  SKIP     $(basename "$f") — no leading '# title'" >&2; continue; }
    # Body is everything after the H1, minus the blank line that follows it.
    sed '1d' "$f" | sed '1{/^$/d;}' > "$tmp"
    id="$(awk -F'\t' -v n="$name" '$1==n{print $2; exit}' "$list")"
    rev="$(awk -F'\t' -v n="$name" '$1==n{print $3; exit}' "$list")"
    if [ -n "$id" ]; then
      if [ "$(sp_content "$p" "$id")" = "$(cat "$tmp")" ]; then
        echo "  same     \"$name\""; continue
      fi
      [ "$DRY" = 1 ] || solo scratchpads update "$id" --project-id "$p" \
        --expected-revision "$rev" --content-file "$tmp" --json >/dev/null
      echo "  update   \"$name\" (id $id)"; c=$((c+1))
    else
      [ "$DRY" = 1 ] || solo scratchpads create --project-id "$p" \
        --name "$name" --content-file "$tmp" --json >/dev/null
      echo "  create   \"$name\""; c=$((c+1))
    fi
  done
  echo "  $n file(s), $c changed"
  rm -f "$list" "$tmp"
}

cmd_notes(){
  local sub="${1:-}"; DRY=0; [ "${2:-}" = "--dry-run" ] && DRY=1
  [ -n "$QUIVER_ROOT" ] || die "set QUIVER_ROOT to your quiver-hq checkout"
  local p name dir
  p="$(need_pid)"; name="$(detect | cut -f2)"
  dir="$QUIVER_ROOT/notes/$name"
  [ "$DRY" = 1 ] && echo "DRY RUN — nothing will be written"
  case "$sub" in
    push) echo "$name: scratchpads -> ${dir#$QUIVER_ROOT/}"; notes_push "$p" "$dir";;
    pull) echo "$name: ${dir#$QUIVER_ROOT/} -> scratchpads"; notes_pull "$p" "$dir";;
    *) die "usage: solo-orch notes <push|pull> [--dry-run]";;
  esac
}

cmd_provision(){
  DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1
  [ -n "$QUIVER_ROOT" ] || die "set QUIVER_ROOT to your quiver-hq checkout"
  [ "$DRY" = 1 ] && echo "DRY RUN — nothing will be written"
  local registered d path name
  registered="$(solo projects list --json | jq -r '.data.projects[].path')"
  for d in "$QUIVER_ROOT" "$QUIVER_ROOT"/projects/*/; do
    path="$(cd "$d" 2>/dev/null && pwd)" || continue
    [ -f "$path/solo.yml" ] || continue
    name="$(sed -n 's/^name:[[:space:]]*//p' "$path/solo.yml" | head -1)"
    [ -n "$name" ] || name="$(basename "$path")"
    if printf '%s\n' "$registered" | grep -qxF "$path"; then
      echo "  ok      $name ($path)"; continue
    fi
    if [ "$DRY" = 1 ]; then echo "  would register $name ($path)"; continue; fi
    solo projects create "$name" "$path" --json \
      | jq -r '"  created \(.data.project.name) [id=\(.data.project.id)]"'
  done
}

# `link` is pure filesystem work, so it runs before the Solo requirement and
# preserves its own exit code (non-zero on conflicts).
if [ "${1:-}" = "link" ]; then shift; cmd_link "${1:-}"; exit $?; fi

need_solo
case "${1:-}" in
  project) cmd_project;;
  agents)  cmd_agents;;
  spawn)   shift; cmd_spawn "${1:-}" "${2:-}";;
  term)    shift; cmd_term "${1:-}";;
  note)    shift; cmd_note "$*";;
  status)  cmd_status;;
  gather)  cmd_gather;;
  ps)      cmd_ps;;
  provision) shift; cmd_provision "${1:-}";;
  notes)     shift; cmd_notes "${1:-}" "${2:-}";;
  *) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
